# Environment variables for homelab-airflow-dags project

# PyPI Server Configuration (used for publishing packages via `just publish-pypi-server`)
PYPI_SERVER_USERNAME=your_username
PYPI_SERVER_PASSWORD=your_password
PYPI_SERVER_URL=https://pypiserver.shawndeng.cc

# uv index auth for the private "homelab" index (declared in root pyproject.toml).
# Same credentials as PYPI_SERVER_*; uv reads UV_INDEX_<NAME>_* for index "homelab".
# Required locally for `uv sync` / `uv lock` to resolve homelab-config & ibkr-quant.
UV_INDEX_HOMELAB_USERNAME=your_username
UV_INDEX_HOMELAB_PASSWORD=your_password
# homelab-config (HomelabSettings, env prefix HOMELAB_). Required by get_config() at DAG parse time.
HOMELAB_ENVIRONMENT=dev
HOMELAB_CONSUL_URLS=https://consul.example.com:8500
HOMELAB_CONSUL_TOKEN=your-consul-token
# Airflow Configuration
AIRFLOW_VERSION=2.11.0
PYTHON_VERSION=3.12

# Docker Compose Configuration
AIRFLOW_IMAGE_NAME=apache/airflow:2.11.0
AIRFLOW_UID=50000
# Repo root; docker-compose mounts dags from packages/homelab-airflow-dags/src/homelab_airflow_dags/dags
AIRFLOW_PROJ_DIR=.

# Airflow Web UI Admin User
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
